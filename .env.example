# Aegis Backend Environment Configuration Template
# Spring Server Port
SERVER_PORT=8080

# Active Spring Profile (tier0: local dev in-memory/simulated; tier1: single-tenant hardened; tier2: multi-tenant production)
SPRING_PROFILES_ACTIVE=tier0

# PostgreSQL Configuration
AEGIS_PG_URL=jdbc:postgresql://127.0.0.1:5432/aegis
AEGIS_PG_USER=aegis
AEGIS_PG_PASSWORD=aegis

# Redis Sliding-Window Velocity Cache (Tier 1 / Tier 2)
AEGIS_REDIS_HOST=127.0.0.1
AEGIS_REDIS_PORT=6379

# Kafka Event Sourcing Stream (Tier 1 / Tier 2)
AEGIS_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# TOTP AES-256-GCM Encryption Key (Base64-encoded 32-byte secret)
# Required in tier1/tier2. Tier 0 auto-generates if omitted.
AEGIS_TOTP_ENC_KEY=YOUR_BASE64_32_BYTE_ENCRYPTION_KEY_HERE

# RS256 JWT Signing Keys (PKCS#8 PEM string or single-line base64)
# Required in tier1/tier2. Tier 0 auto-generates to .dev-keys/ if omitted.
AEGIS_JWT_PRIVATE_KEY=
AEGIS_JWT_PUBLIC_KEY=

# Resend Email API (Used in prod/tier2 for OTPs, invites, and contact inquiries)
# Tier 0 routes all messages to /dev/mailbox
RESEND_API_KEY=re_dummy_dev_key
CONTACT_TO_EMAIL=contact@projectaegis.in
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Public URLs for Redirects and Links
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_CONSOLE_URL=http://localhost:5173

# Testing / Development Flags
# Set to true to execute tests against local PostgreSQL without requiring Docker Desktop
AEGIS_ALLOW_NO_DOCKER=false


