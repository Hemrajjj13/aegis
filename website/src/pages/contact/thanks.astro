---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/siteConfig';
---
<BaseLayout
  title={`Thank You — Message Received — ${siteConfig.productName}`}
  description="Your message has been received by the Project Aegis engineering team."
  canonicalPath="/contact/thanks"
  noindex={true}
>
  <div class="py-20 px-4 max-w-xl mx-auto flex flex-col items-center text-center gap-6">
    <div class="w-14 h-14 rounded-full bg-approve/10 border border-approve/20 flex items-center justify-center text-approve">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
    </div>

    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-bold tracking-tight text-text">
        Message Received
      </h1>
      <p class="text-xs text-text-muted leading-relaxed">
        Thank you for reaching out. Your inquiry has been dispatched to our engineering team. We review inbound communications daily and will reply to your provided work email shortly.
      </p>
    </div>

    <div class="pt-4 flex gap-3">
      <a
        href="/"
        class="py-2 px-4 rounded bg-surface hover:bg-surface-raised border border-border text-text text-xs font-semibold transition-colors"
      >
        Return to Home
      </a>
      <a
        href="/docs"
        class="py-2 px-4 rounded bg-accent-solid hover:bg-accent-hover text-white text-xs font-semibold shadow transition-colors"
      >
        Browse Documentation
      </a>
    </div>
  </div>
</BaseLayout>

