---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/siteConfig';
---
<BaseLayout
  title={`Terms of Service — ${siteConfig.productName}`}
  description="Terms of service and evaluation agreement for Project Aegis."
  canonicalPath="/terms"
>
  <div class="py-12 md:py-16 px-4 max-w-3xl mx-auto flex flex-col gap-8 text-xs text-text-muted leading-relaxed">
    <!-- Notice -->
    <div class="p-3 rounded border border-accent/40 bg-accent/10 text-accent font-mono text-[11px]">
      Draft, needs legal review before launch
    </div>

    <!-- Header -->
    <div class="flex flex-col gap-2">
      <h1 class="text-2xl md:text-3xl font-bold text-text">Terms of Service</h1>
      <p class="font-mono text-[11px]">Last Updated: October 2026</p>
    </div>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-text font-mono">1. Acceptance of Terms</h2>
      <p>
        By accessing or using Project Aegis software, APIs, operator console, or documentation, you agree to be bound by these Terms of Service.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-text font-mono">2. Evaluation &amp; Shadow Mode License</h2>
      <p>
        Subject to these terms, Aegis grants you a non-exclusive, non-transferable license to install, evaluate, and run Tier 0 and Tier 1 instances of the software for internal testing and shadow-mode transaction validation.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-text font-mono">3. Acceptable Use &amp; Prohibited Data</h2>
      <p>
        You agree not to transmit unmasked Primary Account Numbers (PANs), cardholder PIN data, or CVV/CVC codes into Project Aegis. All card payment identifiers must be network tokens (<code>tok_...</code>) or account hashes.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-text font-mono">4. Disclaimer of Warranties</h2>
      <p>
        The software and documentation are provided "as is", without warranty of any kind, express or implied. In no event shall the authors or copyright holders be liable for any claim, damages, or other liability arising from the use of the software.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-text font-mono">5. Governing Law</h2>
      <p>
        These terms shall be governed by and construed in accordance with applicable laws, without regard to conflicts of law provisions.
      </p>
    </section>
  </div>
</BaseLayout>

