---
const faqs = [
  { q: 'Is it live?', a: 'The product is in development. We are in early conversations with design partners and not yet in production.' },
  { q: 'Do you store card numbers?', a: 'The design rejects raw card numbers; only card network tokens are accepted. It is designed to align with PCI scope minimisation.' },
  { q: 'Where is data hosted?', a: 'An India region is the plan (AWS Mumbai), but it is not yet live.' },
  { q: 'How does replay work?', a: 'A candidate rule version is run against a historical dataset and the outcomes are compared to the live version, so you can see the impact before shipping.' },
  { q: 'Can it run in our own cloud?', a: 'Running in your own cloud is planned, but not available yet.' },
  { q: 'What does it cost?', a: 'Pricing is not published yet.' },
  { q: 'Do you have certifications?', a: 'No. There are no certifications yet and none are implied; counsel review is pending.' },
  { q: 'How do I try it?', a: 'Talk to us. Do not send transaction data by email.' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section id="faq" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="text-3xl font-semibold tracking-tight">FAQ</h2>
  <div class="mt-8 space-y-3">
    {faqs.map((f) => (
      <details class="rounded-lg border border-border bg-surface p-4">
        <summary class="cursor-pointer font-medium">{f.q}</summary>
        <p class="mt-2 text-sm text-text-muted">{f.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</section>
