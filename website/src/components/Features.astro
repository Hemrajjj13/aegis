---
import { features } from '../data/features';
---
<section id="features" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="text-3xl font-semibold tracking-tight">Features</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {features.map((f) => (
      <article class="rounded-lg border border-border bg-surface p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-medium">{f.title}</h3>
          <span class="rounded-full border border-border px-2 py-1 text-xs text-text-muted">{f.status}</span>
        </div>
        <p class="mt-3 text-sm text-text-muted">{f.description}</p>
      </article>
    ))}
  </div>
</section>
