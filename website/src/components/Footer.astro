---
import { siteConfig } from '../config/siteConfig';

const productName = siteConfig.productName;
const legalName = siteConfig.legalName;
---
<footer class="border-t border-border bg-surface mt-20 select-none">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <!-- Brand & Mission -->
      <div class="max-w-sm flex flex-col gap-3">
        <a href="/" class="flex items-center gap-2 font-bold tracking-wider font-mono text-text hover:text-accent transition-colors">
          <svg class="w-5 h-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>{productName}</span>
        </a>
        <p class="text-xs text-text-muted leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Links Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 text-xs">
        <div>
          <p class="font-semibold uppercase tracking-wider text-text font-mono">Product</p>
          <ul class="mt-3 space-y-2 text-text-muted">
            <li><a href="/features" class="hover:text-text transition-colors">Features</a></li>
            <li><a href="/how-it-works" class="hover:text-text transition-colors">How it works</a></li>
            <li><a href="/pricing" class="hover:text-text transition-colors">Pricing</a></li>
            <li><a href="/docs" class="hover:text-text transition-colors">Documentation</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold uppercase tracking-wider text-text font-mono">Company</p>
          <ul class="mt-3 space-y-2 text-text-muted">
            <li><a href="/about" class="hover:text-text transition-colors">About</a></li>
            <li><a href="/security" class="hover:text-text transition-colors">Security</a></li>
            <li><a href="/contact" class="hover:text-text transition-colors">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="font-semibold uppercase tracking-wider text-text font-mono">Legal</p>
          <ul class="mt-3 space-y-2 text-text-muted">
            <li><a href="/privacy" class="hover:text-text transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-text transition-colors">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-border mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-muted">
      <p class="font-mono">No cookies. No analytics.</p>
      <p>© {siteConfig.year} {legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>
