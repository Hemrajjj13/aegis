---
import { siteConfig, isPlaceholder } from '../config/siteConfig';
const email = isPlaceholder(siteConfig.contactEmail) ? siteConfig.contactEmail.value : String(siteConfig.contactEmail);
const legalName = isPlaceholder(siteConfig.legalName) ? siteConfig.legalName.value : String(siteConfig.legalName);
const productName = siteConfig.productName;
---
<footer class="border-t border-border">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div>
        <p class="font-semibold">{productName}</p>
        <p class="mt-2 max-w-xs text-sm text-text-muted">{siteConfig.description}</p>
        <p class="mt-4 text-sm text-text-muted">{email}</p>
      </div>
      <div class="flex gap-12 text-sm">
        <div>
          <p class="font-medium">Product</p>
          <ul class="mt-2 space-y-1 text-text-muted">
            <li><a href="#solutions">Solutions</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#how-it-works">How it works</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium">Resources</p>
          <ul class="mt-2 space-y-1 text-text-muted">
            <li><a href="#resources">Resources</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </div>
        <div>
          <p class="font-medium">Company</p>
          <ul class="mt-2 space-y-1 text-text-muted">
            <li><a href="#about">About</a></li>
            <li><a href="#careers">Careers</a></li>
          </ul>
        </div>
      </div>
    </div>
    <p class="mt-8 text-xs text-text-muted">No cookies. No analytics.</p>
    <p class="mt-2 text-xs text-text-muted">© {siteConfig.year} {legalName}</p>
  </div>
</footer>
